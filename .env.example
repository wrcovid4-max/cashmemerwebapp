# ---------------------------------------------------------------------------
# Cash Memer — example settings file.
#
# HOW TO USE THIS FILE
#   1. Make a copy of it called exactly  .env  (a dot, then "env", no .txt)
#   2. Open the copy and paste your real keys in place of the PUT_..._HERE bits
#   3. Save it, then restart the app
#
# THIS FILE IS TRACKED BY GIT. Everyone who can see the repo can see it.
# NEVER put a real key in THIS file — put it in .env, which git ignores.
# The app checks this file on every start and REFUSES TO START if a value in
# here looks like a real key.
#
# Every key below is OPTIONAL. With none of them set, the app still starts and
# everything except the one matching feature works normally.
# ---------------------------------------------------------------------------

# Which port the app listens on. Plain http for this computer.
PORT=4000

# Port for https, used by your phone's camera (phones refuse to open a camera
# over plain http). Leave it alone unless something else uses this port.
HTTPS_PORT=4001

# --- Rates screen -----------------------------------------------------------
# Free key from https://www.exchangerate-api.com  (sign up, copy "API Key")
# Without it: the Rates screen shows a message telling you this is missing.
EXCHANGE_RATE_API_KEY=PUT_YOUR_EXCHANGERATE_API_KEY_HERE

# --- Weekly insight sentence ------------------------------------------------
# Free key from https://aistudio.google.com/apikey
# Without it: History still shows all six weekly numbers, just no AI sentence.
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE

# --- Google sign-in ---------------------------------------------------------
# From https://console.cloud.google.com/apis/credentials  -> OAuth client ID
# -> "Web application". Add this as an Authorised redirect URI:
#     http://localhost:4000/api/auth/google/callback
# Without these: sign-in is hidden, and page 2 of the receipt uses the issuer
# name/email you type into Settings instead.
GOOGLE_CLIENT_ID=PUT_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PUT_YOUR_GOOGLE_CLIENT_SECRET_HERE
